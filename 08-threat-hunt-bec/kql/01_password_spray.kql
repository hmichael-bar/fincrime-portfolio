// Hunt 1 - Password spray (MITRE ATT&CK T1110.003)
// Idea: one IP failing against MANY different accounts, only a few tries each.
// A brute force hammers one account; a spray touches hundreds, quietly.
SigninLogs
| where TimeGenerated > ago(14d)
| where ResultType == 50126                       // invalid username or password
| summarize FailedAccounts = dcount(UserPrincipalName),
            Attempts       = count(),
            FirstSeen      = min(TimeGenerated),
            LastSeen       = max(TimeGenerated),
            UserAgents     = make_set(UserAgent)
            by IPAddress, Country
| where FailedAccounts >= 20                      // many accounts from one IP
| extend AttemptsPerAccount = round(1.0 * Attempts / FailedAccounts, 1)
| order by FailedAccounts desc
